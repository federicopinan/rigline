# Public site URL used for canonical links, sitemap, and Open Graph.
# No trailing slash. Local default is http://localhost:3847 if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3847

# Supabase. Leave both empty to run on the local JSON seed with zero config.
# Use the server secret key (or the legacy service_role key). Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Affiliate tags. Empty values mean the redirect goes to the plain merchant URL.
# Amazon Associates: the real parameter is `tag`.
AMAZON_ASSOCIATE_TAG=
# Best Buy / Walmart / Target: an affiliate id, or a deep-link template containing {url}.
# A bare id is appended as aff_id. A template is how Impact-style networks actually pay.
BESTBUY_AFFILIATE_ID=
WALMART_AFFILIATE_ID=
TARGET_AFFILIATE_ID=

# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Use a long random string. Letters and numbers only. Required for the price route to run.
CRON_SECRET=

# Price refresh. mock is the default and works with no keys.
# auto uses a live adapter only when that adapter's keys are set; otherwise mock.
# amazon and bestbuy force those stubs for matching retailers. The stubs do not call the network.
PRICE_PROVIDER=mock
PRICE_STALE_HOURS=12
PRICE_BATCH_SIZE=100

# Amazon Product Advertising API. The adapter is a stub until signing is implemented.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com

# Best Buy Products API. The adapter is a stub until the request is implemented.
BESTBUY_API_KEY=
